{
  "manifest_version": 3,
  "name": "Piper Reader",
  "version": "1.1.0",
  "minimum_chrome_version": "105",
  "description": "Read the current webpage aloud with Piper Reader's local voices.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:57638/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Read this page with Piper Reader"
  }
}
